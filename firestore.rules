rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Contador de pessoas por item: só aceita somar ou tirar 1 por vez.
    match /itens/{id} {
      allow read: if true;
      allow create: if id in ['camisa-curta', 'camisa-longa', 'gravata', 'calca']
        && request.resource.data.keys().hasOnly(['count'])
        && request.resource.data.count == 1;
      allow update: if id in ['camisa-curta', 'camisa-longa', 'gravata', 'calca']
        && request.resource.data.keys().hasOnly(['count'])
        && request.resource.data.count is int
        && request.resource.data.count >= 0
        && request.resource.data.count <= 500
        && (request.resource.data.count - resource.data.count == 1
            || resource.data.count - request.resource.data.count == 1);
      allow delete: if false;
    }

    // Mural de recados: qualquer pessoa lê e publica; ninguém edita nem apaga pelo site.
    match /recados/{id} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['nome', 'texto', 'criadoEm'])
        && request.resource.data.nome is string
        && request.resource.data.nome.size() > 0
        && request.resource.data.nome.size() <= 40
        && request.resource.data.texto is string
        && request.resource.data.texto.size() > 0
        && request.resource.data.texto.size() <= 280
        && request.resource.data.criadoEm == request.time;
      allow update, delete: if false;
    }
  }
}
